+
+static ssize_t charging_enabled_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct power_supply *psy = dev_get_drvdata(dev);
+	struct smb_chip *chip = power_supply_get_drvdata(psy);
+	unsigned int val = 0;
+	int ret;
+
+	ret = regmap_read(chip->regmap, chip->base + CHARGING_ENABLE_CMD, &val);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d\n", !!(val & CHARGING_ENABLE_CMD_BIT));
+}
+
+static ssize_t charging_enabled_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct power_supply *psy = dev_get_drvdata(dev);
+	struct smb_chip *chip = power_supply_get_drvdata(psy);
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(chip->regmap, chip->base + CHARGING_ENABLE_CMD,
+				 CHARGING_ENABLE_CMD_BIT,
+				 enable ? CHARGING_ENABLE_CMD_BIT : 0);
+	if (ret)
+		return ret;
+
+	power_supply_changed(psy);
+	return count;
+}
+static DEVICE_ATTR_RW(charging_enabled);
+
+static struct attribute *smb_charger_attrs[] = {
